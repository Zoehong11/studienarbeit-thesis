@inproceedings{loredolopezNYTConnectionsDeceptivelySimple2025,
  title = {{{NYT-Connections}}: {{A Deceptively Simple Text Classification Task}} That {{Stumps System-1 Thinkers}}},
  shorttitle = {{{NYT-Connections}}},
  booktitle = {Proceedings of the 31st {{International Conference}} on {{Computational Linguistics}}},
  author = {Loredo Lopez, Angel Yahir and McDonald, Tyler and Emami, Ali},
  editor = {Rambow, Owen and Wanner, Leo and Apidianaki, Marianna and Al-Khalifa, Hend and Eugenio, Barbara Di and Schockaert, Steven},
